# Plantilla de variables de entorno de FluneXy.
# Copia este archivo como .env y completa los valores reales.
# NO subir el archivo .env al repositorio ni colocar aqui claves reales.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: PostgreSQL (SQLite no se utiliza en este proyecto)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Origenes permitidos para el frontend
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# MOD17 - Asistente Inteligente (OpenRouter)
OPENROUTER_API_KEY=
